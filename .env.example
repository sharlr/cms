# =============================================================================
# Production environment template — Concours National de Logique CMS
# Domain: https://cms.nexusrajan.com/
# Host port (nginx upstream): 8888
#
# Fill in secrets, then paste the full file into GitHub secret: SERVER_ENV
# =============================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=https://cms.nexusrajan.com
HOST_PORT=8888

POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=cms
DATABASE_URL=postgresql://cms:change-me-strong-db-password@db:5432/cms

AUTH_SECRET=change-me-to-a-long-random-secret-min-32-chars

SEED_ON_START=false

# Optional email delivery webhook
MAIL_WEBHOOK_URL=
